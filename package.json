{
  "name": "studyforge",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npx wrangler pages dev public",
    "lint:js": "eslint functions/ public/js/ scripts/",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:spelling": "cspell \"functions/**/*.js\" \"public/**/*.html\" \"public/js/**/*.js\"",
    "check:types": "tsc -p jsconfig.json",
    "check": "npm run lint:js && npm run lint:html && npm run lint:css && npm run lint:spelling"
  },
  "devDependencies": {
    "@cspell/dict-id-id": "^1.0.9",
    "@eslint/js": "^10.0.1",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^7.0.2"
  }
}
